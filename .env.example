# Copia este archivo a .env y rellena las credenciales. .env esta en .gitignore.
#
# Desde 2026 las apps nuevas no tienen token shpat_ permanente: se usan Client ID y
# Client Secret del dev dashboard (dev.shopify.com > Apps > tu app > Settings) y el
# codigo los cambia por un access token de 24 h en cada ejecucion.
#
# El Secret es una credencial. Si se filtra, rotalo desde el dev dashboard.

SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
