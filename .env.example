# Copy this file to .env and add credentials. .env is gitignored.
# The client ID and secret are exchanged for a fresh 24-hour access token on every run.
# Treat the secret as a password; rotate it in the Shopify Dev Dashboard if exposed.

SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
